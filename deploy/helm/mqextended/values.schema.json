{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "additionalVoter", "autoRecover", "image", "storage", "listeners", "auth", "mqttTLS", "service", "resources"],
  "properties": {
    "replicaCount": { "type": "integer", "enum": [1, 2, 3] },
    "additionalVoter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "autoRecover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "qos1ReplayBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "setTcpNoDelay": { "type": "boolean" },
    "brokerOptions": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "allow_duplicate_messages", "check_retain_source", "cluster_max_snapshot_size",
          "global_max_clients", "global_max_connections", "max_inflight_bytes", "max_inflight_messages",
          "max_keepalive", "max_packet_size", "max_queued_bytes", "max_queued_messages", "message_size_limit",
          "persistent_client_expiration", "queue_qos0_messages", "retain_available", "retain_expiry_interval",
          "sys_interval", "upgrade_outgoing_qos"
        ]
      },
      "additionalProperties": {
        "oneOf": [
          { "type": "boolean" },
          { "type": "integer", "minimum": 0 },
          { "type": "string", "pattern": "^[A-Za-z0-9.]+$" }
        ]
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "pattern": "^[^\\s@]+$" },
        "tag": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size"],
      "properties": {
        "storageClassName": { "type": ["string", "null"] },
        "size": { "type": "string", "minLength": 1 }
      }
    },
    "listeners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mqtt", "mqtts", "ws", "wss"],
      "properties": {
        "mqtt": { "$ref": "#/definitions/listener" },
        "mqtts": { "$ref": "#/definitions/listener" },
        "ws": { "$ref": "#/definitions/listener" },
        "wss": { "$ref": "#/definitions/listener" }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowAnonymous", "existingSecret", "passwordFile", "aclFile"],
      "properties": {
        "allowAnonymous": { "type": "boolean" },
        "existingSecret": { "$ref": "#/definitions/secretName" },
        "passwordFile": { "type": "boolean" },
        "aclFile": { "type": "boolean" }
      }
    },
    "mqttTLS": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret"],
      "properties": { "existingSecret": { "$ref": "#/definitions/secretName" } }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "annotations"],
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "LoadBalancer"] },
        "loadBalancerClass": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "not": {
            "anyOf": [
              { "required": ["mqextended.io/voter-count"] },
              { "required": ["mqextended.io/client-count"] }
            ]
          }
        }
      },
      "if": { "properties": { "type": { "const": "ClusterIP" } } },
      "then": { "properties": { "loadBalancerClass": { "const": "" } } }
    },
    "resources": { "type": "object" }
  },
  "definitions": {
    "listener": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "port"],
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "secretName": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "additionalVoter": { "properties": { "enabled": { "const": true } } } } },
      "then": { "properties": { "replicaCount": { "const": 2 } } }
    }
  ]
}
